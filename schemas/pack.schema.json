{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cassette Studio Pack",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "author", "version", "gameVersion", "receiptKey", "artwork", "tracks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "gameVersion": { "type": "string", "minLength": 1 },
    "receiptKey": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$" },
    "description": { "type": "string" },
    "giftName": { "type": "string" },
    "giftDescription": { "type": "string" },
    "deliveryDelayDays": { "type": "integer", "minimum": 1, "maximum": 365, "default": 1 },
    "artwork": { "type": "string", "minLength": 1 },
    "normalize": { "type": "boolean", "default": true },
    "targetLufs": { "type": "number", "minimum": -30, "maximum": -12, "default": -18 },
    "workshop": {
      "type": "object",
      "properties": {
        "publishedFileId": { "type": "string", "pattern": "^[0-9]+$", "default": "0" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "preview": { "type": "string" },
        "visibility": { "type": "integer", "enum": [0, 1, 2], "default": 2 },
        "changeNote": { "type": "string" }
      }
    },
    "tracks": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "required": ["key", "title", "audio"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "titleEn": { "type": "string" },
          "description": { "type": "string" },
          "descriptionEn": { "type": "string" },
          "audio": { "type": "string", "minLength": 1 },
          "sprite": { "enum": ["cassette1", "cassette10", "cassette3", "cassette4", "cassette5", "cassette6", "cassette7", "cassette8", "cassette9"] }
        }
      }
    }
  }
}
